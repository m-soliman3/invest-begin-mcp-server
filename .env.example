# Auto-Trader backend on Cloud Run (no trailing slash).
BACKEND_URL=https://auto-trader-backend-xxxxxxxx-uc.a.run.app

# Must match ANALYSIS_READ_KEY on the backend. This key is accepted ONLY on
# GET /v1/analysis* — it cannot trigger the runner or place an order.
ANALYSIS_READ_KEY=

# Optional shared secret for this MCP endpoint itself. Clients then send
# `Authorization: Bearer <token>`. Leave empty for an open (no-auth) connector.
MCP_AUTH_TOKEN=

PORT=8080
REQUEST_TIMEOUT_MS=15000
DEFAULT_TIMEFRAME=1h
